+
+    pair = &state->pairs[idx];
+    state->state = FREUND_STATE_LOOP;
+    printf("[FREUND] Step %d: loop skipped for update test (%s)\n", pair->step, pair->loop_path);
+}
+
+static void freund_prepare_next_pair(ProjectRuntime* runtime, VideoEngine* ve_fg)
+{
+    FreundRuntimeState* state = (FreundRuntimeState*)runtime->user;
+    const FreundPair* pair;
+    int next_idx;
+
