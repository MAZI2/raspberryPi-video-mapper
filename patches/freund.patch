+    }
+    if (state->active_pair_idx < 0 || state->active_pair_idx >= state->pair_count) {
+        return;
+    }
+
+    next_idx = (state->active_pair_idx + 1) % state->pair_count;
+    pair = &state->pairs[next_idx];
+    ve_prepare_transition_opts(ve_fg, pair->transition_path, 0);
+}
