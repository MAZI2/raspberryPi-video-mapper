+static int freund_pair_cmp(const void* a, const void* b)
+{
+    const FreundPair* pa = (const FreundPair*)a;
+    const FreundPair* pb = (const FreundPair*)b;
+    return pa->step - pb->step;
+}
+
+static int freund_find_loop_for_step(const Playlist* loops, int step, const char** out_path)
+{
+    for (int i = 0; i < loops->count; i++) {
+        int loop_step = 0;
+        if (freund_parse_step_prefix(loops->items[i], &loop_step) && loop_step == step) {
+            *out_path = loops->items[i];
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int freund_build_pairs(FreundRuntimeState* state)
+{
+    FreundPair* pairs;
+    int count = 0;
+
+    if (state->transitions.count <= 0 || state->loops.count <= 0) {
+        return 0;
+    }
+
+    pairs = (FreundPair*)calloc((size_t)state->transitions.count, sizeof(FreundPair));
+    if (!pairs) {
+        return 0;
+    }
+
+    for (int i = 0; i < state->transitions.count; i++) {
+        int step = 0;
+        const char* loop_path = NULL;
+
+        if (!freund_parse_step_prefix(state->transitions.items[i], &step)) {
+            continue;
+        }
+        if (!freund_find_loop_for_step(&state->loops, step, &loop_path)) {
+            continue;
+        }
+
+        pairs[count].step = step;
+        pairs[count].transition_path = state->transitions.items[i];
+        pairs[count].loop_path = loop_path;
+        count++;
+    }
+
+    if (count <= 0) {
+        free(pairs);
+        return 0;
+    }
+
+    qsort(pairs, (size_t)count, sizeof(FreundPair), freund_pair_cmp);
+    state->pairs = pairs;
+    state->pair_count = count;
+    state->active_pair_idx = -1;
+    state->state = FREUND_STATE_BACKGROUND;
+    return 1;
+}
+
+static void freund_request_pair(ProjectRuntime* runtime, VideoEngine* ve_fg, int pair_idx)
+{
+    FreundRuntimeState* state = (FreundRuntimeState*)runtime->user;
+    const FreundPair* pair;
+
+    if (!state || pair_idx < 0 || pair_idx >= state->pair_count) {
+        return;
+    }
+
+    state->active_pair_idx = pair_idx;
+    state->state = FREUND_STATE_TRANSITION;
+    pair = &state->pairs[pair_idx];
+
+    printf("[FREUND] Step %d: transition -> %s\n", pair->step, pair->transition_path);
+    ve_request_transition_opts(ve_fg, pair->transition_path, 0);
+}
+
+static void freund_finish_transition_without_loop(ProjectRuntime* runtime)
+{
